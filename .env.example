# Variables de entorno del servicio api (cmd/api). Copiá este archivo a
# .env y completá los valores reales — .env está en .gitignore, nunca se
# commitea. Cargalo con tu herramienta de siempre (direnv, `source .env`,
# `env $(cat .env | xargs) make run`, etc.); este proyecto no incluye un
# cargador de .env propio, internal/plataforma/configuracion lee
# directamente del entorno del proceso (os.Getenv).
#
# "(producción)" marca las variables sin las que el proceso NO arranca
# cuando APP_ENV=production — ver cada ADR referenciado para el porqué.
# Fuera de producción, todas tienen un fallback de desarrollo con un WARN
# explícito de arranque (nunca silencioso).

# --- Servidor ----------------------------------------------------------
PORT=8080
APP_ENV=development

# --- Base de datos (PostgreSQL) -----------------------------------------
# Rol dueño: solo para DDL/migraciones (cmd/migrador). Ver deployments/docker-compose.yml.
DATABASE_URL=postgres://auth_service:auth_service_dev_password@localhost:5432/auth_service?sslmode=disable
# Rol de login en tiempo de ejecución, privilegios acotados (ADR 0017,
# migración 000003). Sin ella, el proceso api cae a DATABASE_URL (rol
# dueño) con un WARN — no usar así en producción.
DATABASE_URL_APLICACION=postgres://rol_login_identidad:identidad_app_dev_password@localhost:5432/auth_service?sslmode=disable

# --- Redis (Confianza: rate limiting/captcha, colas, reconocimiento de origen) ----
# Sin ella, Confianza arranca en modo no-op (sin rate limiting real) — ver ADR 0018.
REDIS_URL=redis://localhost:6379/0

# --- Acceso: firma de tokens JWT (ADR 0019/0020) ------------------------
# Ed25519 (PEM PKCS8 o seed/llave en base64). (producción)
ACCESO_LLAVE_FIRMA=
# Llaves de verificación previas, separadas por comas — ventana de rotación.
ACCESO_LLAVES_VERIFICACION_PREVIAS=
# Claim "iss" del token de acceso. (producción, con default de desarrollo)
ACCESO_EMISOR=https://accesos.moterus.local
# Claim "aud" fijo (ADR 0002: un solo producto). (producción, con default de desarrollo)
ACCESO_AUDIENCIA=moterus

# --- Identidad: cifrado de secretos TOTP (ADR 0038, docs/design/otp-mfa.md §2.2) ----
# AES-256-GCM, 32 bytes en base64. (producción)
IDENTIDAD_LLAVE_CIFRADO_MFA=

# --- Confianza: captcha invisible (ADR 0003/0018) -----------------------
# Cloudflare Turnstile, llave secreta server-side. (producción)
TURNSTILE_SECRET_KEY=
# Sobreescribe el endpoint de verificación de Cloudflare — solo para tests
# con un servidor local, nunca hace falta en un despliegue real.
TURNSTILE_VERIFY_URL=

# --- Correo transaccional real (ADR 0054/0055) --------------------------
# SMTP genérico (no un proveedor de API: no hay dominio propio que
# verificar). Gmail: smtp.gmail.com, puerto 587, usuario = tu Gmail,
# contraseña = una "contraseña de aplicación" (no tu contraseña normal).
# Sin SMTP_HOST/SMTP_REMITENTE, Identidad/Tenencia caen a su stub log-only
# (el token de verificación/invitación queda solo en el log). (producción)
SMTP_HOST=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CONTRASENA=
SMTP_REMITENTE=Moterus <no-reply@ejemplo.com>

# --- Frontend (opcional, ADR 0054) --------------------------------------
# Base de un futuro cliente propio (no existe todavía, ADR 0002). Si está
# definida, los correos de verificación/invitación incluyen un enlace
# clicable; si no, presentan el token en claro para uso directo contra la API.
URL_FRONTEND=
